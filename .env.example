# Biến môi trường cho 3D Asset Organizer
# Sao chép file này thành `.env` và điền giá trị thực

# --- Google Gemini API ---
# Lấy API key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model sử dụng — để TRỐNG để app tự động chọn model tốt nhất khả dụng.
# Các model được hỗ trợ (tùy account): gemini-2.5-flash, gemini-2.0-flash, gemini-2.5-pro
# Chỉ điền nếu muốn ép dùng model cụ thể.
GEMINI_MODEL=
